<script>
  import { ON } from "lusiajs";

  const fadeIn = { 0: { opacity: 0 }, 1: { opacity: 1 } };
  const glow = { 0: { filter: "brightness(1)" }, 1: { filter: "brightness(1.4)" } };
</script>

<div class="box" animate={[
  { play: fadeIn, on: ON.VIEW, duration: 400 },
  { play: glow, on: ON.HOVER },
]}>Hi</div>
