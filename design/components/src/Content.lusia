<script>
  import { variable } from "lusiajs";
  import Card from "./Card.lusia";

  const clicks = variable(0);

  function addClick() {
    clicks.value++;
  }
</script>

<Card title="Inbox">
  <p>{clicks} clicks, counted by the parent</p>
  <button onclick={addClick} type="button">Click</button>
</Card>
