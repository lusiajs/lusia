<script>
	import { variable, props } from "lusiajs";
	import Folder from "./Folder.lusia";

	interface Item {
		name: string;
		children?: Item[];
	}

	const { item } = props(class {
	  item: Item = { name: "" };
	});
	const open = variable(true);
	const children = variable.compute(() => item.children ?? []);

	function toggle() {
		open.value = !open.value;
	}
</script>

<li>
	<IF {item.children}>
		<button type="button" onclick={toggle}>{item.name}</button>
		<IF {open}>
			<ul>
				<EACH {children} as={child} key={child.name}>
					<Folder item={child} />
				</EACH>
			</ul>
		</IF>
	<ELSE>
		<span>{item.name}</span>
	</IF>
</li>
