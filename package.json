{
  "name": "lusiajs",
  "version": "0.1.0-beta.3",
  "description": "Write UI in one file. Update it with variables. Built for Bun.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ui",
    "framework",
    "bun",
    "typescript",
    "components",
    "reactive",
    "scss",
    "single-file"
  ],
  "homepage": "https://lusia.azpepoze.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusiajs/lusia.git"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "bin": {
    "lusia": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "reference",
    "lusia.d.ts",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "docs",
    "llms.txt",
    "llms-full.txt"
  ],
  "exports": {
    ".": "./src/runtime/index.ts",
    "./internal": "./src/runtime/internal.ts",
    "./markers": "./src/runtime/markers.ts",
    "./compiler": "./src/compiler/index.ts",
    "./bun-plugin": "./src/bun-plugin/index.ts",
    "./config": "./src/config/index.ts",
    "./api": "./reference/api.ts",
    "./language/*": "./src/language/*",
    "./editor/*": "./src/editor/*",
    "./errors/*": "./src/compiler/errors/*",
    "./types": "./lusia.d.ts",
    "./compiler/*": "./src/compiler/*"
  },
  "imports": {
    "#language/lint/style-compile": {
      "browser": "./src/language/lint/rules/style-compile.browser.ts",
      "default": "./src/language/lint/rules/style-compile.ts"
    },
    "#runtime/*": "./src/runtime/*",
    "#compiler/*": "./src/compiler/*",
    "#bun-plugin/*": "./src/bun-plugin/*",
    "#cli/*": "./src/cli/*",
    "#language/*": "./src/language/*"
  },
  "scripts": {
    "dev:stress": "bun src/cli/index.ts dev examples/stress",
    "test": "bun test --parallel=6 ./test/ ./examples/",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "tsc --noEmit",
    "bench:style": "bun scripts/bench-style-scope.ts",
    "check": "bun scripts/check.ts",
    "docs:generate": "bun scripts/generate-docs.ts",
    "prepack": "bun scripts/generate-docs.ts"
  },
  "dependencies": {
    "prettier": "3.10.1",
    "sass": "^1.80.0",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "@types/bun": "latest",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
