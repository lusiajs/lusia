<script>
import { props } from "lusiajs";
import { variable } from "lusiajs";
import Tree from "./Tree.lusia";

const { node } = props(class {
  node = { name: "", children: [] };
});
const open = variable(true);
const children = variable.compute(() => node.children);

function toggle() {
  open.value = !open.value;
}
</script>

<li class="tree-node">
  <button class="toggle" onclick={toggle}>{node.name}</button>
  <IF {open}>
    <ul>
      <EACH {children} as={child} key={child.name}>
        <Tree node={child} />
      </EACH>
    </ul>
  </IF>
</li>
