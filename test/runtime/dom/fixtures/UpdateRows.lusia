<script>
import { updateState } from "./update-state.ts";
import Stamp from "./Stamp.lusia";
</script>

<ul>
  <EACH {updateState.rows} as={item} key={item.id}>
    <li class="row" title={item.title} onclick={() => (updateState.picked.value = item.title)}>
      <span class="name">{item.title}</span>
      <IF {item.done}>
        <b class="done">done</b>
      </IF>
      <span class="upper">{item.tags.map((item) => item.toUpperCase()).join(",")}</span>
      <EACH {item.tags} as={tag}>
        <i class="nested">{item.title}/{tag}</i>
      </EACH>
      <Stamp label={item.title} />
    </li>
  </EACH>
</ul>
