<script>
  import { attach, onAttach, type Instance } from "lusiajs";
  import Child from "./Child.lusia";

  onAttach((root: Element) => {
    const child: Instance = attach(Child, root.querySelector(".slot")!);
    return () => child.detach();
  });
</script>

<div class="parent">
  <p class="mark">Parent</p>
  <div class="slot"></div>
</div>

<style>
  .mark { outline: 2px solid rebeccapurple; }

  @scoped {
    .mark { background: lightyellow; }
  }
</style>
