<script>
  import { ON, PRESET } from "lusiajs";
  import { on } from "./on.ts";

  // Each badge leaves with this OUT animation, so removal waits for it.
  const fadeOut = {
    0: { opacity: 1 },
    1: { opacity: 0 },
  };
</script>

<div class="flow-toggle">
  <IF {on.value}>
    <span
      class="badge"
      animate={[{ play: PRESET.FADE_IN, on: ON.ATTACH, duration: 20 }, { play: fadeOut, on: ON.DETACH, duration: 20 }]}
      >On</span
    >
  </IF>
</div>
