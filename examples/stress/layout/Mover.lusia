<script>
  import { ON } from "lusiajs";

  // Each item glides when the wrapping changes, so the whole list moves at once.
  const glide = { on: ON.MOVE, duration: 400 };
</script>

<li class="mover" animate={glide}>
  <span>Item</span>
</li>

<style>
  .mover {
    padding: 0.25rem 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }
</style>
