<script>
  import { ON, EASE } from "lusiajs";

  const colorAndMove = {
    0: { color: "#e11d48", translate: "-12px 0px" },
    1: [EASE.STYLE.QUART, EASE.INOUT, { color: "#2563eb", translate: "0px 0px" }],
  };

  const fade = {
    0: [EASE.STYLE.LINEAR, EASE.IN, { opacity: 0 }],
    1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1 }],
  };

  const fadeOut = {
    0: [EASE.STYLE.LINEAR, EASE.IN, { opacity: 1 }],
    1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 0 }],
  };
</script>

<li
  class="tile"
  animate={[
  { play: colorAndMove, on: ON.ATTACH, duration: 300 },
  { play: fade, on: ON.ATTACH, duration: 300 },
  { play: fadeOut, on: ON.DETACH, duration: 300, options: { animateSpace: true } },
]}
>
  <span>Tile</span>
</li>

<style>
  .tile {
    padding: 0.25rem 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }
</style>
