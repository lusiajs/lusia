{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lusia.config.json",
  "description": "Settings for lusia build, dev, format and lint. Put the file in the app folder. CLI flags override it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "outdir": {
      "type": "string",
      "minLength": 1,
      "description": "Output folder for lusia build, relative to the app folder. Default: dist"
    },
    "minify": {
      "type": "boolean",
      "description": "Minify the build. Default: true"
    },
    "routes": {
      "type": "array",
      "description": "Client routes that get their own index.html, such as /guide",
      "items": {
        "type": "string",
        "description": "Starts with a slash and has no .."
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Dev server port. Default: 3000"
        }
      }
    },
    "lazy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["smart", "all", "off"],
          "description": "Which imported components load later. Default: smart"
        },
        "prefetch": {
          "enum": ["idle", "view", "none"],
          "description": "When split components start to download. Default: idle"
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lint settings for lusia lint and the editors",
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "description": "Severity of each lint rule: off hides it, warn shows it, error fails lusia lint",
          "properties": {
            "unused-import": { "enum": ["off", "warn", "error"] },
            "props-twice": { "enum": ["off", "warn", "error"] },
            "unknown-prop": { "enum": ["off", "warn", "error"] },
            "empty-expression": { "enum": ["off", "warn", "error"] },
            "style-attribute": { "enum": ["off", "warn", "error"] },
            "animate-keyframes": { "enum": ["off", "warn", "error"] },
            "animate-key": { "enum": ["off", "warn", "error"] },
            "scroll-old-form": { "enum": ["off", "warn", "error"] },
            "scroll-numeric-line": { "enum": ["off", "warn", "error"], "description": "Old name of scroll-old-form. Still works." },
            "flow-chain": { "enum": ["off", "warn", "error"] },
            "bind-target": { "enum": ["off", "warn", "error"] },
            "unused-class": { "enum": ["off", "warn", "error"] },
            "untyped-class": { "enum": ["off", "warn", "error"] }
          }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings for lusia format",
      "properties": {
        "indentScriptAndStyle": {
          "type": "boolean",
          "default": true,
          "description": "Indent the code inside <script> and <style> by one level"
        }
      }
    },
    "screens": {
      "type": "object",
      "description": "Screen sizes for SCREEN and the screen() Sass mixin. Each name is the width where that screen starts, in px. The smallest must start at 0. Default: PHONE 0, TABLET 600, DESKTOP 1000",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "not": { "required": ["REDUCED_MOTION"] },
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "minProperties": 1
    },
    "animate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default timing and options for every animate item. An item in code overrides them. Enum values are written as names, such as \"QUART\".",
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Length of one play, in ms. Default: 300"
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "description": "Wait before each forward play, in ms. Default: 0"
        },
        "ease": {
          "type": "array",
          "description": "[easing style, direction]. Default: [\"QUART\", \"INOUT\"]",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "$ref": "#/$defs/easeStyle" }, { "$ref": "#/$defs/ease" }],
          "items": false
        },
        "keep": {
          "type": "boolean",
          "description": "Remove the inline styles when a play ends. Default: true"
        },
        "midway": {
          "type": "object",
          "additionalProperties": false,
          "description": "What a new play does while one is running",
          "properties": {
            "play": {
              "enum": ["TURN", "FINISH", "RESTART", "SKIP", "IGNORE"],
              "description": "Default: TURN"
            },
            "turn": {
              "enum": ["SUDDEN", "SMOOTH", "STOP"],
              "description": "How the motion turns around. Default: SUDDEN"
            },
            "turnDuration": {
              "type": "number",
              "minimum": 0,
              "description": "Length of the turn, in ms. Default: 200"
            },
            "turnStyle": {
              "$ref": "#/$defs/easeStyle",
              "description": "Easing style of the turn. Default: CUBIC"
            },
            "turnEase": {
              "$ref": "#/$defs/ease",
              "description": "Direction of the turn. Default: INOUT"
            }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for WHEN.VIEW",
          "properties": {
            "margin": {
              "description": "How far inside the screen edge: a number of px, or a CSS length such as \"10%\". Default: \"0px\"",
              "oneOf": [{ "type": "number" }, { "type": "string" }]
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share of the element that must be visible, 0 to 1. Default: 0.15"
            },
            "reverse": {
              "type": "boolean",
              "description": "Play back out when it leaves the view. Default: false"
            }
          }
        },
        "hover": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for WHEN.HOVER",
          "properties": {
            "inDelay": {
              "type": "number",
              "minimum": 0,
              "description": "Wait after pointer enter before playing in, in ms. Default: 0"
            },
            "outDelay": {
              "type": "number",
              "minimum": 0,
              "description": "Wait after pointer leave before playing out, in ms. Default: 0"
            },
            "outDuration": {
              "type": "number",
              "minimum": 0,
              "description": "Length of the play out, in ms. Used only when the item sets out. Default: the item duration"
            }
          }
        },
        "scroll": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for WHEN.SCROLL",
          "properties": {
            "start": {
              "$ref": "#/$defs/scrollPoint",
              "description": "Where the progress starts, as [element edge, screen edge]. Default: [0, 1]"
            },
            "end": {
              "$ref": "#/$defs/scrollPoint",
              "description": "Where the progress ends, as [element edge, screen edge]. Default: [1, 0]"
            },
            "part": {
              "type": "array",
              "description": "[from, to] of the progress to play. Default: [0, 1]",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for WHEN.ATTACH",
          "properties": {
            "animateSpace": {
              "type": "boolean",
              "description": "Slide the siblings apart to open the space. false: they jump at once. Default: false"
            }
          }
        },
        "detach": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for WHEN.DETACH",
          "properties": {
            "animateSpace": {
              "type": "boolean",
              "description": "Slide the siblings into the freed space. false: they jump at once. Default: false"
            }
          }
        },
        "in": {
          "anyOf": [{ "$ref": "#/$defs/preset" }, { "type": "object" }],
          "description": "Preset used by items with no style, on attach and other triggers. Default: none"
        },
        "out": {
          "anyOf": [{ "$ref": "#/$defs/preset" }, { "type": "object" }],
          "description": "Preset used by items with no style, on detach. Default: none"
        }
      }
    }
  },
  "$defs": {
    "easeStyle": {
      "enum": [
        "LINEAR",
        "QUAD",
        "CUBIC",
        "QUART",
        "QUINT",
        "SINE",
        "EXPO",
        "CIRC",
        "BACK",
        "ELASTIC",
        "BOUNCE"
      ]
    },
    "ease": {
      "enum": ["IN", "OUT", "INOUT"]
    },
    "scrollPoint": {
      "description": "[element edge, screen edge]. Each edge is a number from 0 (top) to 1 (bottom).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "preset": {
      "enum": [
        "FADE_IN",
        "FADE_OUT",
        "SLIDE_UP",
        "SLIDE_DOWN",
        "SLIDE_LEFT",
        "SLIDE_RIGHT",
        "POP_IN",
        "POP_OUT",
        "ZOOM_IN",
        "ZOOM_OUT",
        "FLIP_IN",
        "FLIP_OUT",
        "BLUR_IN",
        "BLUR_OUT",
        "DROP_IN",
        "BOUNCE_IN",
        "SHAKE",
        "PULSE",
        "SPIN",
        "WOBBLE",
        "HEARTBEAT",
        "TADA"
      ]
    }
  }
}
